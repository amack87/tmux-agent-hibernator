<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
    <key>Label</key>
    <string>com.tmux-agent-hibernator</string>
    <key>ProgramArguments</key>
    <array>
        <string>/usr/bin/python3</string>
        <string>-m</string>
        <string>hibernator.daemon</string>
    </array>
    <key>WorkingDirectory</key>
    <!-- UPDATE THIS to your clone location -->
    <string>/Users/YOU/tmux-agent-hibernator</string>
    <key>EnvironmentVariables</key>
    <dict>
        <key>PYTHONPATH</key>
        <!-- UPDATE THIS to your clone location -->
        <string>/Users/YOU/tmux-agent-hibernator</string>
        <key>PATH</key>
        <string>/opt/homebrew/bin:/usr/local/bin:/usr/bin:/bin</string>
    </dict>
    <key>StartInterval</key>
    <integer>300</integer>
    <key>StandardOutPath</key>
    <string>/tmp/tmux-agent-hibernator.log</string>
    <key>StandardErrorPath</key>
    <string>/tmp/tmux-agent-hibernator-error.log</string>
    <key>RunAtLoad</key>
    <true/>
</dict>
</plist>
